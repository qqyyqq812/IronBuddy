# IronBuddy environment configuration template
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# All values can also be set in `.api_config.json` (also gitignored).
# Lookup order: env > ~/.ironbuddy/secrets.env > .api_config.json

# ============================================================
# Board (Toybrick RK3399ProX) — local network
# ============================================================
IRONBUDDY_BOARD_IP=10.29.10.224
IRONBUDDY_BOARD_USER=toybrick
IRONBUDDY_BOARD_ROOT=/home/toybrick/streamer_v3

# ============================================================
# Cloud GPU node (RTMPose + Qdrant + bge-m3 embedding)
# ============================================================
CLOUD_SSH_HOST=root@your-gpu-host.example.com
CLOUD_SSH_PORT=22
CLOUD_SSH_USER=root
CLOUD_SSH_PASSWORD=
CLOUD_RTMPOSE_URL=http://localhost:6006/infer
CLOUD_LOCAL_TUNNEL_PORT=6006

# RAG services on the cloud node
RAG_VECTOR_HOST=localhost
RAG_VECTOR_PORT=6333
RAG_EMBEDDING_HOST=localhost
RAG_EMBEDDING_PORT=8008
RAG_EMBEDDING_MODEL=BAAI/bge-m3

# ============================================================
# Baidu AipSpeech (ASR + TTS) — REQUIRED for voice
# ============================================================
BAIDU_APP_ID=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ============================================================
# DeepSeek LLM — REQUIRED for coach chat
# ============================================================
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ============================================================
# Feishu OpenCloud — OPTIONAL (training reminders)
# ============================================================
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_secret_here
FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IRONBUDDY_FEISHU_DRY_RUN=1

# ============================================================
# Tencent ADP knowledge base — OPTIONAL (fitness QA)
# ============================================================
ADP_APP_KEY=
ADP_BASE_URL=

# ============================================================
# OpenClaw bridge (claude-mem WebSocket gateway)
# ============================================================
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_TOKEN=

# ============================================================
# Runtime toggles
# ============================================================
ENABLE_HDMI=1
VISION_MODE=local
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FOURCC=MJPG
CLOUD_TARGET_FPS=15
CLOUD_JPEG_QUALITY=72

# ============================================================
# OpenClaw Daemon scheduling (optional, defaults in openclaw_daemon.py)
# ============================================================
# DAILY_PLAN_HOUR=9
# WEEKLY_REPORT_DOW=6
# WEEKLY_REPORT_HOUR=20
# PREFERENCE_HOUR=23
